# Sao chép file này thành `.env` rồi điền thông tin thật. KHÔNG commit file `.env`.
NEO4J_URI=neo4j+s://<id>.databases.neo4j.io
NEO4J_USER=<username>
NEO4J_PASSWORD=<password>

# Tuỳ chọn (có giá trị mặc định)
# FILE_HO_TRO=data/support.csv
# FILE_XUNG_DOT=data/conflict.csv
# PYKEEN_MODEL=TransE
# PYKEEN_EPOCHS=100
# DIEM_THUONG_HO_TRO=0.5
# TOP_K=3
# TOI_DA_KICH_BAN=5000
